{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "Prometheus",
        "enable": true,
        "hide": true,
        "iconColor": "#f93f17",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Requests (rate)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (endpoint)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "HTTP Latency (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    }
    ,
    {
      "type": "graph",
      "title": "Cache Hits (rate)",
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[5m])) by (key_prefix)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Cache Misses (rate)",
      "targets": [
        {
          "expr": "sum(rate(cache_misses_total[5m])) by (key_prefix)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "stat",
      "title": "Cache Invalidations Total",
      "targets": [
        {
          "expr": "sum(cache_invalidations_total)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Business Health - Tasks Created",
      "targets": [
        {
          "expr": "sum(increase(task_created_total[1d])) by (service_type, status)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "WhatsApp Funnel",
      "targets": [
        {
          "expr": "sum(rate(whatsapp_message_sent_total[5m])) by (status, message_type)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Payout Pipeline",
      "targets": [
        {
          "expr": "sum(rate(payout_processed_total[5m])) by (status)",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "OpenAI Call Duration",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(openai_call_duration_seconds_bucket[5m])) by (le))",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Celery Task Duration",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_duration_seconds_bucket[5m])) by (le, task_name, status))",
          "format": "time_series"
        }
      ],
      "datasource": "Prometheus"
    }
  ],
  "schemaVersion": 27,
  "title": "ElderCare - Basic HTTP Metrics",
  "version": 1
}
